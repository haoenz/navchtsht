% navi, 索引, 速查表, 基础

# 查找命令、工具搜索、命令速查、命令大全、备忘
navi

# 新手入门、教程、示例｜查看内置 cheatsheet
navi fn welcome

# 预填关键词过滤｜快速定位、搜索框预填
navi -q <关键词>

# 标签过滤片段｜排除某些标签、分类筛选
navi --tag-rules 'navi,!基础'

# 标签加关键词筛选｜缩小范围、精确查找
navi -q <关键词> --tag-rules 'navi'

% navi, 非交互, 脚本

# 直接执行最佳匹配｜自动选择、非交互、脚本
navi --query <关键词> --best-match

# 只打印不执行｜预览、审查、复制命令、管道
navi --print --best-match --query <关键词>

# 环境变量预设变量值｜跳过变量提问、自动化
owner=denisidoro repo=cheats navi --print --query '导入仓库' --best-match

# 打印原始模板｜不做变量替换、调试、占位符
navi --print --prevent-interpolation --best-match --query <关键词>

% navi, 变量

# 变量逐个提示输入｜交互填空、自定义参数
echo '你好，<名字>'

# 变量候选来自命令输出｜下拉选择、枚举、补全
echo '今天是 <日期>'

$ 日期: date +%F

# 固定候选值｜单选、选项列表、预设
echo '日志级别：<级别>'

$ 级别: printf '%s\n' debug info warn error

% navi, 仓库

# 导入他人仓库｜安装速查表、clone、扩展
navi repo add <owner>/<repo>

$ owner: echo denisidoro
$ repo: echo cheats

# 浏览精选仓库｜发现推荐、找现成速查表
navi repo browse

# 查看已导入仓库｜列表、已安装、本地缓存
ls ~/.local/share/navi/cheats

% navi, 仓库, 清理

# 移除已导入仓库｜卸载、删除、清理
repo=<repo>; rm -rf "$HOME/.local/share/navi/cheats/${repo:?}"

$ repo: ls ~/.local/share/navi/cheats 2>/dev/null | head -20

% navi, Shell 集成, 快捷键

# zsh 快捷键组件｜Ctrl+G 唤出、shell 集成
eval "$(navi widget zsh)"

# bash 快捷键组件｜Ctrl+G 唤出、shell 集成
eval "$(navi widget bash)"

# fish 快捷键组件｜shell 集成、快捷调用
navi widget fish | source

% navi, 在线源, 远程

# 在线查 tldr 示例｜免本地导入、社区速查
navi --tldr <命令名>

$ 命令名: echo docker

# 在线查 cheat.sh｜社区片段、补充本地
navi --cheatsh <命令名>

$ 命令名: echo tar

% navi, 配置

# 配置文件路径｜配置在哪、改配置
navi info config-path

# cheat 目录路径｜安装位置、仓库位置
navi info cheats-path

# 官方配置样例｜配置模板、样式、finder 设置
navi info config-example

# 临时指定 cheat 目录｜自定义路径、多仓库
navi --path <目录>

$ 目录: echo ~/文档/navchtsht/cheats

% navi, 编写 cheat, 语法

# cheat 语法速览｜标签、注释、变量、$ 定义
navi info cheats-example

# 校验新片段｜只打印匹配、自查、回归测试
navi --path <目录> --print --best-match --query <关键词>

$ 目录: echo ~/文档/navchtsht/cheats
$ 关键词: echo 标签
