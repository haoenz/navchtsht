% 7z, 压缩, 打包

# 压缩文件或目录｜创建 7z 包、a；目录会包含子目录
7z a -t7z "<压缩包>" "<源路径>"

# 创建 ZIP 压缩包｜zip、兼容常见解压工具
7z a -tzip "<压缩包>" "<源路径>"

# 最高压缩率｜-mx9、体积优先、压缩较慢
7z a -t7z -mx9 "<压缩包>" "<源路径>"

# 快速压缩｜-mx1、速度优先
7z a -t7z -mx1 "<压缩包>" "<源路径>"

# 排除文件或目录｜递归忽略匹配项，如 *.log 或 node_modules
7z a -t7z "<压缩包>" "<源路径>" '-xr!<排除模式>'

# 按清单打包｜UTF-8 文本每行一个路径、@listfile
7z a -t7z -scsUTF-8 "<压缩包>" @"<清单文件>"

% 7z, 解压, 提取

# 解压到当前目录｜x、保留包内目录结构
7z x "<压缩包>"

# 解压到指定目录｜-o 紧接路径、保留目录结构
7z x "<压缩包>" -o"<输出目录>"

# 平铺解压文件｜e、去掉目录层级、注意同名文件
7z e "<压缩包>" -o"<输出目录>"

# 提取指定文件｜包内相对路径、单文件解压
7z x "<压缩包>" "<包内路径>" -o"<输出目录>"

# 按类型解压｜递归匹配，如 *.txt；引号保留通配符
7z x "<压缩包>" '-ir!<匹配模式>' -o"<输出目录>"

# 跳过已有文件｜-aos、同名文件不覆盖
7z x "<压缩包>" -o"<输出目录>" -aos

# 覆盖已有文件｜-aoa、同名文件直接替换
7z x "<压缩包>" -o"<输出目录>" -aoa

# 自动重命名冲突文件｜-aot、同名冲突时保留两份
7z x "<压缩包>" -o"<输出目录>" -aot

# 输出文件到标准输出｜-so、供管道处理；填写单个包内文件
7z x "<压缩包>" "<包内路径>" -so

% 7z, 加密, 密码, 分卷

# 加密压缩并隐藏文件名｜7z 格式、交互输入密码
7z a -t7z -p -mhe=on "<压缩包>" "<源路径>"

# 解压加密压缩包｜交互输入密码、保留目录结构
7z x "<压缩包>" -o"<输出目录>"

# 分卷压缩大文件｜生成 .001、.002；卷大小如 100m、1g
7z a -t7z "<压缩包>" "<源路径>" -v<卷大小>

# 解压分卷压缩包｜选择 .001 首卷，所有分卷放同一目录
7z x "<首卷路径>" -o"<输出目录>"

% 7z, 查看, 校验

# 查看压缩包内容｜l、列出文件、不解压
7z l "<压缩包>"

# 查看压缩包详细信息｜-slt、压缩方法、属性
7z l -slt "<压缩包>"

# 检查压缩包完整性｜t、测试损坏、CRC 校验
7z t "<压缩包>"

# 计算文件 SHA256｜哈希、校验和、摘要
7z h -scrcSHA256 "<文件>"

# 查看支持的压缩格式｜i、格式列表、编解码器
7z i

# 查看命令帮助｜参数、选项、用法
7z --help

% 7z, 更新, 删除

# 追加文件到压缩包｜a、同名项可能被替换
7z a "<压缩包>" "<源路径>"

# 更新压缩包文件｜u、添加新文件并更新较新的文件
7z u "<压缩包>" "<源路径>"

# 删除包内文件｜d、直接修改压缩包、填写包内路径
7z d "<压缩包>" "<包内路径>"
