% git, alias, zsh, 基础

# git 本身、入口、g
g

# 查看状态、gst、status
gst

# 简短状态、gst、gss、status short
gss

# 简短状态含分支跟踪、gsb、status branch
gsb

# 帮助、ghh、help
ghh

# 查看全部配置、gcf、config list
gcf

# 跳转到仓库根目录、grt、root toplevel
grt

# 拉取变基当前分支（调用 ggu 函数）、ggpur、pull rebase
ggpur

